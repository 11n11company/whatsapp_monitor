# ====================================================================
# WhatsApp Monitor - Master Environment Configuration (Phase 1)
# ====================================================================
# Note: Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env

# ----------------- BACKEND SETTINGS -----------------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# JWT Secret Key (Use a cryptographically random string for production)
JWT_SECRET=whatsapp_monitor_jwt_secret_phase1_key_change_in_production
JWT_EXPIRES_IN=24h

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_monitor
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional direct connection URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_monitor

# Default Seed Administrator Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@WhatsApp2025!
ADMIN_EMAIL=admin@whatsappmonitor.local
ADMIN_FULL_NAME=Super Admin

# WhatsApp Real Provider & Session Encryption (Phase 4)
WHATSAPP_PROVIDER=baileys
SESSION_ENCRYPTION_KEY=whatsapp_monitor_aes_256_gcm_session_key_secret_2025

# ----------------- FRONTEND SETTINGS ----------------
VITE_API_BASE_URL=/api

