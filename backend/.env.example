# ==========================================
# WhatsApp Monitor - Backend Environment Config
# Phase 1: Project Foundation
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
# IMPORTANT: Generate a strong, random 64-char key for production
JWT_SECRET=whatsapp_monitor_jwt_secret_phase1_key_change_in_production
JWT_EXPIRES_IN=24h

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_monitor
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Optional connection string (overrides individual DB settings if provided)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_monitor

# Default Administrator Seed Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@WhatsApp2025!
ADMIN_EMAIL=admin@whatsappmonitor.local
ADMIN_FULL_NAME=Super Admin

# WhatsApp Real Provider & Session Encryption (Phase 4)
# Options: 'baileys' (Real QR Web provider) or 'demo' (Simulated provider)
WHATSAPP_PROVIDER=baileys
# 32-byte secret key used for AES-256-GCM authenticated encryption at rest
SESSION_ENCRYPTION_KEY=whatsapp_monitor_aes_256_gcm_session_key_secret_2025

