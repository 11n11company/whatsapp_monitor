# ====================================================================
# WhatsApp Monitor - Production Environment Template (.env.production.example)
# ====================================================================
# INSTRUCTIONS:
# 1. Copy this file to backend/.env on your production host:
#    cp .env.production.example backend/.env
# 2. Generate secure random secrets:
#    JWT_SECRET:           openssl rand -hex 32
#    SESSION_ENCRYPTION:   openssl rand -hex 32
# 3. Fill in real PostgreSQL credentials and your production frontend domain.
# 4. NEVER commit your live .env file to version control.
# ====================================================================

# ----------------- SERVER CONFIGURATION -----------------
NODE_ENV=production
PORT=5000

# Production Frontend URL (Used by CORS allowlist)
CORS_ORIGIN=https://whatsapp-monitor.yourcompany.com

# ----------------- JWT AUTHENTICATION -----------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_cryptographically_secure_random_hex_string
JWT_EXPIRES_IN=24h

# ----------------- REAL POSTGRESQL CONFIGURATION -----------------
# In production, in-memory fallback is disabled. Database connection is required.
DB_HOST=postgres.internal.yourcompany.com
DB_PORT=5432
DB_NAME=whatsapp_monitor_prod
DB_USER=whatsapp_app_user
DB_PASSWORD=replace_with_strong_production_db_password
DB_SSL=true

# Optional complete connection string (e.g. AWS RDS / Supabase / DigitalOcean):
# DATABASE_URL=postgresql://whatsapp_app_user:password@host:5432/whatsapp_monitor_prod?sslmode=require

# ----------------- INITIAL ADMIN SEED -----------------
# Only seeded if the admin_users table is empty. Must be changed on first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_complex_initial_admin_password_16chars_min
ADMIN_EMAIL=security-admin@yourcompany.com
ADMIN_FULL_NAME=Company WhatsApp Administrator

# ----------------- REAL BAILEYS WHATSAPP CONNECTION -----------------
# 'baileys' uses real WhatsApp Web Multi-Device protocol
WHATSAPP_PROVIDER=baileys

# Master AES-256-GCM Session Key (used to encrypt multi-device credentials at rest)
# CRITICAL: If this key is lost, all salespersons must re-scan QR codes!
# Keep a secure backup in your company's password/vault manager.
# Generate with: openssl rand -hex 32
SESSION_ENCRYPTION_KEY=replace_with_64_character_hex_key_for_aes_256_gcm_session_storage

